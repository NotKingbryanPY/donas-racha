<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_container"
    android:orientation="vertical"
    android:padding="8dp"
    tools:ignore="Overdraw">

    <TextView
        android:id="@+id/widgetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Donas Control"
        android:textColor="@color/on_primary_container"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widgetSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:text="Cargando ventas e inventario…"
        android:textColor="@color/on_primary_container"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cantidad"
            android:textColor="@color/on_primary_container"
            android:textSize="12sp" />

        <Button
            android:id="@+id/widgetMinus"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Reducir cantidad"
            android:text="−"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widgetQuantity"
            android:layout_width="40dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/on_primary_container"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/widgetPlus"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:contentDescription="Aumentar cantidad"
            android:text="+"
            android:textSize="20sp" />
    </LinearLayout>

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/widgetCash"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Efectivo"
            android:textSize="12sp" />

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/widgetYappy"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Yappy"
            android:textSize="12sp" />

        <Button
            style="?android:attr/buttonBarButtonStyle"
            android:id="@+id/widgetPurchase"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:text="Comprar"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
