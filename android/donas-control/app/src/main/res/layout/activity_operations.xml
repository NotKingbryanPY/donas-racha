<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="?attr/actionBarSize" app:navigationIcon="@drawable/ic_home" app:title="Control diario" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="@color/primary_container" app:strokeWidth="0dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                    <TextView android:id="@+id/session" android:layout_width="match_parent" android:layout_height="wrap_content" android:textAppearance="@style/SectionTitle" android:textColor="@color/on_primary_container" />
                    <TextView android:id="@+id/dashboard" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:lineSpacingExtra="6dp" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" android:textColor="@color/on_primary_container" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
                        <com.google.android.material.button.MaterialButton android:id="@+id/startSession" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Iniciar jornada" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/closeSession" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="Cerrar jornada" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Vender" android:textAppearance="@style/SectionTitle" />
            <com.google.android.material.button.MaterialButton android:id="@+id/saleQuick" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="8dp" android:text="🍩 Nueva venta" android:textSize="16sp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/undo" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Deshacer última venta" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Operaciones" android:textAppearance="@style/SectionTitle" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp">
                <com.google.android.material.button.MaterialButton android:id="@+id/purchase" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar compra y pago combinado" />
                <com.google.android.material.button.MaterialButton android:id="@+id/transfer" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Transferir Efectivo ↔ Yappy" />
                <com.google.android.material.button.MaterialButton android:id="@+id/expense" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Registrar gasto" />
                <com.google.android.material.button.MaterialButton android:id="@+id/loan" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Préstamos y pagos" />
                <com.google.android.material.button.MaterialButton android:id="@+id/adjust" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ajustar inventario" />
                <com.google.android.material.button.MaterialButton android:id="@+id/partner" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Pagar ganancia a socio" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Estadísticas" android:textAppearance="@style/SectionTitle" />
            <TextView android:id="@+id/statistics" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="6dp" android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Historial reciente" android:textAppearance="@style/SectionTitle" />
            <TextView android:id="@+id/history" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:lineSpacingExtra="8dp" android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
            <com.google.android.material.button.MaterialButton android:id="@+id/filterHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Filtrar historial" />
            <com.google.android.material.button.MaterialButton android:id="@+id/moreHistory" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Cargar 50 anteriores" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="Datos y almacenamiento" android:textAppearance="@style/SectionTitle" />
            <com.google.android.material.button.MaterialButton android:id="@+id/export" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Exportar copia de seguridad" />
            <com.google.android.material.button.MaterialButton android:id="@+id/importData" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Importar copia de seguridad" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resetBusiness" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reiniciar datos del negocio" />
            <com.google.android.material.button.MaterialButton android:id="@+id/resetSession" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Reiniciar solo jornada actual" />
            <com.google.android.material.button.MaterialButton android:id="@+id/factoryReset" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="24dp" android:text="Restablecer toda la aplicación" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
